{
  "expo": {
    "name": "MULTIOKS Partner",
    "slug": "7starworker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "starworker",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.7starexperts.worker",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.starexperts.worker",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#0F0E2A"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#6366F1"
        }
      ],
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MULTIOKS Partner to access your camera for proof of job completion."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MULTIOKS Partner to access photos for document uploads."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "MULTIOKS Partner needs your location to show customers where you are during a job.",
          "locationAlwaysPermission": "MULTIOKS Partner uses background location to track your route during active jobs.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#08090E"
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d54ea291-ff92-42b1-9bbf-e7ce898842b6"
      }
    },
    "owner": "stars-seven",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
